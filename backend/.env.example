APP_ENV=development
DEBUG=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tabspace
MYSQL_USER=tabspace
MYSQL_PASSWORD=replace-with-local-password
REDIS_URL=redis://127.0.0.1:6379/0
UPLOADS_DIR=storage/uploads
ARTIFACTS_DIR=storage/artifacts
# Optional explicit interpreter for the Demucs subprocess. If empty, the API
# tries .venv-audio, .venv-worker, then the current Python interpreter.
AUDIO_PROCESSING_PYTHON=
DEMUCS_MODEL_NAME=htdemucs_6s
DEMUCS_PASSES=2
